{
  "expo": {
    "name": "ThreadFlow",
    "slug": "timeflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "threadflow",
    "icon": "./assets/app-icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ThreadFlow to access your photos for category icons.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "locales": {
      "en": "./locales/en.json",
      "zh-CN": "./locales/zh-CN.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.timeflow.ios",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.threadflow.app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0dff552-a8e5-4a98-b79e-b78fd9225a59"
      }
    }
  }
}
